# Копия -> /data/local/tmp/wwan.conf, читается wwan-up.sh при запуске.
# Всё необязательно: без файла берутся значения по умолчанию.

WWAN_APN=internet          # APN оператора (beeline: internet.beeline.kz)
#WWAN_USER=                # логин, если оператор его требует
#WWAN_PASS=                # пароль
#WWAN_DIAL='*99#'          # номер дозвона
#WWAN_TABLE=99             # таблица маршрутизации для ppp0
#WWAN_MODDIR=/data/local/tmp   # где лежат .ko и huawei-modeswitch
#WWAN_DNS=1.1.1.1          # DNS для приложений вместо того, что дал оператор;
                           # auto или пусто — как раньше. Главнее кнопки «DNS» в
                           # приложении (она пишет в state/dns). См. docs/app-network.md
#WWAN_VPN=1                # совместимость с VPN-клиентами на VpnService (HAPP,
                           # v2rayNG, WireGuard). Без неё клиент показывает
                           # «подключено», а трафик приложений идёт мимо туннеля.
                           # См. docs/app-network.md
#WWAN_VPN_MAIN_PREF=23500  # куда переезжает вендорское «from all lookup main»
