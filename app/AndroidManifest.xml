<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="su.dsr.f515usbwwan"
    android:versionCode="40"
    android:versionName="4.8">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="29" />

    <!-- INTERNET: приложение ходит к локальному adbd по 127.0.0.1:5555 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        directBootAware: BOOT_COMPLETED на этой голове приходит раньше, чем становится
        доступно credential-encrypted хранилище, поэтому и receiver, и сервис, и признак
        автозапуска (Autostart, device-protected prefs) должны работать до разблокировки.
    -->
    <application
        android:label="F515 USB WWAN"
        android:icon="@mipmap/ic_launcher"
        android:directBootAware="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:label="F515 USB WWAN"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".BootService"
            android:directBootAware="true"
            android:exported="false" />
    </application>
</manifest>
